# Discord bot token
DISCORD_TOKEN=

# Optional: sync commands instantly to one test Discord server
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs allowed to manage servers.
# Empty = Discord Administrator permission required.
ALLOWED_ROLE_IDS=

# Comma-separated Discord user IDs for bot-owner-only commands
OWNER_USER_IDS=

# Pterodactyl panel URL, no trailing slash
PTERO_PANEL_URL=https://panel.example.com

# Client API key for servers the account can access
PTERO_CLIENT_API_KEY=

# Application API key for panel administration/provisioning (optional, highly privileged)
PTERO_APPLICATION_API_KEY=

# Optional channel for audit messages
AUDIT_CHANNEL_ID=

# Optional default user/server allocation IDs used by provisioning
DEFAULT_ALLOCATION_ID=
DEFAULT_EGG_ID=
DEFAULT_LOCATION_ID=
DEFAULT_NEST_ID=

# SQLite path
DATABASE_PATH=zerox_ptero.sqlite3

# Log level
LOG_LEVEL=INFO
